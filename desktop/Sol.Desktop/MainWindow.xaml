<Window x:Class="Sol.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sol" Style="{StaticResource {x:Type Window}}" Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}" Width="1400" Height="920" MinWidth="1040" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,26,20,18">
        <StackPanel DockPanel.Dock="Top" Margin="10,0,0,30">
          <StackPanel Orientation="Horizontal"><Image Source="{DynamicResource SolLogo}" Width="42" Height="42" Stretch="Uniform" Margin="0,0,12,0"/><TextBlock Text="Sol" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
          <TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource Subtle}" Margin="0,30,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Button x:Name="SettingsNavigation" Style="{StaticResource NavigationButton}" Content="设置与运行环境" Click="SettingsClick" Margin="0,12,0,16"/>
          <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="6,18,0,0">
            <DockPanel><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource NavActive}" Margin="0,0,10,0"><TextBlock Text="S" FontSize="15" Foreground="{DynamicResource AccentLabel}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
              <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SidebarIdentity" Text="Sol" FontSize="12"/><TextBlock x:Name="SidebarStatus" Text="内部引擎尚未启动" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
            </DockPanel>
          </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Navigation"/></ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="30,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ReviewDialogButton" Style="{StaticResource ToolbarButton}" Visibility="Collapsed" Content="弹窗配色" Click="ReviewDialogClick"/>
            <Button x:Name="ThemeButton" Style="{StaticResource ToolbarButton}" Content="切换暗色" Click="ThemeClick" ToolTip="暖白浅色 / 暗色"/>
            <Button Style="{StaticResource ToolbarButton}" Content="管理页 ↗" Click="BrowserClick" ToolTip="在浏览器打开完整管理页"/>
            <Button Style="{StaticResource ToolbarButton}" Content="刷新" Click="RefreshClick" Margin="0"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="工作空间" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock Text="/" Foreground="{DynamicResource Subtle}" Margin="14,0"/><TextBlock x:Name="BreadcrumbTitle" Text="运行总览" FontSize="12"/></StackPanel>
        </DockPanel>
      </Border>
      <Border Grid.Row="1" x:Name="NoticeBox" Background="{DynamicResource Notice}" Padding="30,12" Visibility="Collapsed"><TextBlock x:Name="Notice" Foreground="{DynamicResource NoticeText}"/></Border>
      <Grid Grid.Row="2" Margin="32,28,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24"><TextBlock x:Name="PageTitle" Text="运行总览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="你的机器人、任务与记忆，一处掌握。" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel>
        <ContentControl x:Name="PageContent" Grid.Row="1"/>
      </Grid>
      <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,7"><DockPanel><TextBlock x:Name="Timestamp" DockPanel.Dock="Right" Foreground="{DynamicResource Subtle}" FontSize="10"/><TextBlock x:Name="Footer" Text="本机管理 · 关闭窗口后在托盘运行" Foreground="{DynamicResource Muted}" FontSize="10"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
