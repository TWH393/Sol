<Application x:Class="Sol.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries>
      <BitmapImage x:Key="SolLogoLight" UriSource="/Assets/sol-main.jpg" />
      <BitmapImage x:Key="SolLogoDark" UriSource="/Assets/sol-dark.jpg" />
      <BitmapImage x:Key="SolIconLight" UriSource="/Assets/sol-main.ico" />
      <BitmapImage x:Key="SolIconDark" UriSource="/Assets/sol-dark.ico" />
      <BitmapImage x:Key="SolAppIcon" UriSource="/Assets/sol-app.ico" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
